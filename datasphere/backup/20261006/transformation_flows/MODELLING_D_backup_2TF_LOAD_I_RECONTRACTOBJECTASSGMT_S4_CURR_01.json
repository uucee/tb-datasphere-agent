                  "@DataWarehouse.consumption.external": false,
                  "@DataWarehouse.sqlEditor.query": "/* ==========================================================================\r\n   2TF_LOAD_I_RECONTRACTOBJECTASSGMT_S4_CURR_01  -  transformation flow source SQL\r\n   Target         : 2LT_I_RECONTRACTOBJECTASSGMT_S4_AUD_CURR_01\r\n   Batch control  : revised framework. Stamps rows with the batch open for\r\n                    S4_CURR at load time. Fail-closed: with no open batch, or\r\n                    with I_RECONTRACTOBJECTASSGMT not registered in the load\r\n                    manifest for that batch, the flow stages nothing.\r\n   ------------------------------------------------------------------------ */\r\nSELECT\r\n    b.\"BATCH_ID\"                                       AS \"BATCH_ID\",\r\n    b.\"BATCH_TYPE\"                                     AS \"BATCH_TYPE\",\r\n    COALESCE(o.\"LOAD_START_TS\", b.\"BATCH_OPENED_TS\")   AS \"LOAD_TIMESTAMP\",\r\n    b.\"SOURCE_SYSTEM\"                                  AS \"SOURCE_SYSTEM\",\r\n    o.\"LOAD_FLOW\"                                      AS \"LOAD_FLOW\",\r\n    o.\"OBJECT_NAME\"                                    AS \"OBJECT_NAME\",\r\n    d.\"REStatusObjectSource\",\r\n    d.\"REObjectAssignmentType\",\r\n    d.\"REStatusObjectTarget\",\r\n    d.\"ValidityStartDate\",\r\n    d.\"ValidityEndDate\",\r\n    d.\"REOnlyInfoAssgmt\",\r\n    d.\"REStatusObjectSourceIsArchived\",\r\n    d.\"REGenerationType\",\r\n    d.\"REIsMainAsset\",\r\n    d.\"REAssignmentHasMultiple\",\r\n    d.\"REObjectPossessionStartDate\",\r\n    d.\"REObjectPossessionEndDate\",\r\n    d.\"REIsLeadingObject\"\r\nFROM \"1_INBOUND_S4_CURR_D\".\"1LT_I_RECONTRACTOBJECTASSGMT_S4_CURR\" AS d\r\nCROSS JOIN \"2SV_CTRL_ACTIVE_BATCH_01\" AS b\r\nJOIN \"2LT_CTRL_LOAD_OBJECT_01\" AS o\r\n    ON  o.\"BATCH_ID\"      = b.\"BATCH_ID\"\r\n    AND o.\"SOURCE_SYSTEM\" = b.\"SOURCE_SYSTEM\"\r\n    AND o.\"OBJECT_NAME\"   = 'I_RECONTRACTOBJECTASSGMT'\r\nWHERE b.\"SOURCE_SYSTEM\" = 'S4_CURR'\r\n "
