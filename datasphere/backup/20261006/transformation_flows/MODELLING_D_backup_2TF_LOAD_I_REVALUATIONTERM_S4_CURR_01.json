                  "@DataWarehouse.consumption.external": false,
                  "@DataWarehouse.sqlEditor.query": "/* ==========================================================================\r\n   2TF_LOAD_I_REVALUATIONTERM_S4_CURR_01  -  transformation flow source SQL\r\n   Target         : 2LT_I_REVALUATIONTERM_S4_AUD_CURR_01\r\n   Batch control  : revised framework. Stamps rows with the batch that is\r\n                    open for S4_CURR at load time. Fail-closed: with no open\r\n                    batch, or with I_REVALUATIONTERM not registered in the\r\n                    load manifest for that batch, the flow stages nothing.\r\n   ------------------------------------------------------------------------ */\r\nSELECT\r\n    b.\"BATCH_ID\"                AS \"BATCH_ID\",\r\n    b.\"BATCH_TYPE\"              AS \"BATCH_TYPE\",\r\n    o.\"LOAD_START_TS\"           AS \"LOAD_TIMESTAMP\",\r\n    b.\"SOURCE_SYSTEM\"           AS \"SOURCE_SYSTEM\",\r\n    o.\"LOAD_FLOW\"               AS \"LOAD_FLOW\",\r\n    o.\"OBJECT_NAME\"             AS \"OBJECT_NAME\",\r\n    d.\"InternalRealEstateNumber\",\r\n    d.\"REValuationRuleUUID\",\r\n    d.\"RETermNumber\",\r\n    d.\"RETermType\",\r\n    d.\"ValidityStartDate\",\r\n    d.\"ValidityEndDate\",\r\n    d.\"REStatusObject\",\r\n    d.\"ObjectValidFrom\",\r\n    d.\"REValuationRule\",\r\n    d.\"REConsiderationStartDate\",\r\n    d.\"RECashFlowPostingFromDate\",\r\n    d.\"REStatusObjectAsset\",\r\n    d.\"REValuationClassification\",\r\n    d.\"REInterestRate\",\r\n    d.\"REFrequencyTerm\",\r\n    d.\"REDistributionRule\",\r\n    d.\"REDistributionRuleParam1\",\r\n    d.\"REDistributionRuleParam2\",\r\n    d.\"REProbableEndDate\",\r\n    d.\"REAssetRightOfUseEndDate\",\r\n    d.\"REValuationRuleStatus\",\r\n    d.\"REValuationStatus\",\r\n    d.\"REValuationStatusReason\",\r\n    d.\"REValuationBehavior\",\r\n    d.\"RETaxType\",\r\n    d.\"TaxGroup\",\r\n    d.\"REAccountingObject\",\r\n    d.\"REInfoText\",\r\n    d.\"REValuationFactorNumerator\",\r\n    d.\"REValuationFactorDenominator\",\r\n    d.\"REValuationCurrency\",\r\n    d.\"REValuationQuestionnaireUUID\",\r\n    d.\"Country\"\r\nFROM \"1_INBOUND_S4_CURR_D\".\"1LT_I_REVALUATIONTERM_S4_CURR\" AS d\r\nCROSS JOIN \"2SV_CTRL_ACTIVE_BATCH_01\" AS b\r\nJOIN \"2LT_CTRL_LOAD_OBJECT_01\" AS o\r\n    ON  o.\"BATCH_ID\"      = b.\"BATCH_ID\"\r\n    AND o.\"SOURCE_SYSTEM\" = b.\"SOURCE_SYSTEM\"\r\n    AND o.\"OBJECT_NAME\"   = 'I_REVALUATIONTERM'\r\nWHERE b.\"SOURCE_SYSTEM\" = 'S4_CURR'"
