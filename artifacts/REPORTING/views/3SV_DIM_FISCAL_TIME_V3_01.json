{   "definitions": {     "3SV_DIM_FISCAL_TIME_V3_01": {       "kind": "entity",       "elements": {         "FISCAL_YEAR_VARIANT": {           "@EndUserText.label": "Fiscal year variant",           "type": "cds.String",           "length": 2,           "key": true,           "notNull": true,           "@Analytics.dimension": true,           "@Semantics.fiscal.yearVariant": true         },         "FISCAL_YEAR_PERIOD": {           "@EndUserText.label": "Fiscal year + fiscal period",           "type": "cds.String",           "length": 7,           "key": true,           "notNull": true,           "@Analytics.dimension": true,           "@Semantics.fiscal.yearPeriod": true         },         "FISCAL_YEAR": {           "@EndUserText.label": "Fiscal year",           "type": "cds.String",           "length": 4,           "@Analytics.dimension": true,           "@Semantics.fiscal.year": true         },         "FISCAL_PERIOD": {           "@EndUserText.label": "Fiscal period",           "type": "cds.String",           "length": 3,           "@Analytics.dimension": true,           "@Semantics.fiscal.period": true         },         "FISCAL_PERIOD_START_DATE": {           "@EndUserText.label": "FISCAL_PERIOD_START_DATE",           "type": "cds.Date",           "@Semantics.date": true         },         "FISCAL_PERIOD_END_DATE": {           "@EndUserText.label": "FISCAL_PERIOD_END_DATE",           "type": "cds.Date",           "@Semantics.date": true         }       },       "query": {         "SELECT": {           "from": {             "ref": [               "3GV_DIM_FISCALCALENDAR_01"             ],             "as": "CAL"           },           "columns": [             {               "ref": [                 "CAL",                 "FiscalYearVariant"               ],               "as": "FISCAL_YEAR_VARIANT"             },             {               "ref": [                 "CAL",                 "FiscalYearPeriod"               ],               "as": "FISCAL_YEAR_PERIOD"             },             {               "ref": [                 "CAL",                 "FiscalYear"               ],               "as": "FISCAL_YEAR"             },             {               "ref": [                 "CAL",                 "FiscalPeriod"               ],               "as": "FISCAL_PERIOD"             },             {               "func": "TO_DATE",               "args": [                 {                   "func": "MIN",                   "args": [                     {                       "ref": [                         "CAL",                         "FiscalPeriodStartDate"                       ]                     }                   ]                 },                 {                   "val": "YYYYMMDD"                 }               ],               "as": "FISCAL_PERIOD_START_DATE"             },             {               "func": "TO_DATE",               "args": [                 {                   "func": "MAX",                   "args": [                     {                       "ref": [                         "CAL",                         "FiscalPeriodEndDate"                       ]                     }                   ]                 },                 {                   "val": "YYYYMMDD"                 }               ],               "as": "FISCAL_PERIOD_END_DATE"             }           ],           "groupBy": [             {               "ref": [                 "CAL",                 "FiscalYearVariant"               ]             },             {               "ref": [                 "CAL",                 "FiscalYearPeriod"               ]             },             {               "ref": [                 "CAL",                 "FiscalYear"               ]             },             {               "ref": [                 "CAL",                 "FiscalPeriod"               ]             }           ],           "where": [             {               "ref": [                 "CAL",                 "FiscalYearVariant"               ]             },             "=",             {               "val": "V3"             },             "and",             {               "ref": [                 "CAL",                 "Language"               ]             },             "=",             {               "val": "EN"             }           ]         }       },       "@ObjectModel.supportedCapabilities": [         {           "#": "ANALYTICAL_DIMENSION"         }       ],       "@EndUserText.label": "3SV_DIM_FISCAL_TIME_V3_01",       "@ObjectModel.modelingPattern": {         "#": "ANALYTICAL_DIMENSION"       },       "@Semantics.fiscal.yearPeriod": true,       "@Semantics.interval": [         {           "lowerBoundaryElement": {             "=": "FISCAL_PERIOD_START_DATE"           },           "lowerBoundaryIncluded": true,           "upperBoundaryElement": {             "=": "FISCAL_PERIOD_END_DATE"           },           "upperBoundaryIncluded": false         }       ],       "@Hierarchy.leveled": [         {           "name": "Hierarchy",           "label": "Hierarchy",           "levels": [             {               "element": {                 "=": "FISCAL_YEAR"               }             },             {               "element": {                 "=": "FISCAL_YEAR_PERIOD"               }             }           ]         }       ],       "@DataWarehouse.consumption.external": false,       "@DataWarehouse.sqlEditor.query": "SELECT\r\n    CAL.\"FiscalYearVariant\" AS \"FISCAL_YEAR_VARIANT\",\r\n    CAL.\"FiscalYearPeriod\"  AS \"FISCAL_YEAR_PERIOD\",\r\n    CAL.\"FiscalYear\"        AS \"FISCAL_YEAR\",\r\n    CAL.\"FiscalPeriod\"      AS \"FISCAL_PERIOD\",\r\n\r\n    TO_DATE(\r\n        MIN(CAL.\"FiscalPeriodStartDate\"),\r\n        'YYYYMMDD'\r\n    ) AS \"FISCAL_PERIOD_START_DATE\",\r\n\r\n    TO_DATE(\r\n        MAX(CAL.\"FiscalPeriodEndDate\"),\r\n        'YYYYMMDD'\r\n    ) AS \"FISCAL_PERIOD_END_DATE\"\r\n\r\nFROM \"3GV_DIM_FISCALCALENDAR_01\" CAL\r\nWHERE CAL.\"FiscalYearVariant\" = 'V3'\r\n  AND CAL.\"Language\" = 'EN'\r\nGROUP BY\r\n    CAL.\"FiscalYearVariant\",\r\n    CAL.\"FiscalYearPeriod\",\r\n    CAL.\"FiscalYear\",\r\n    CAL.\"FiscalPeriod\""     }   } }