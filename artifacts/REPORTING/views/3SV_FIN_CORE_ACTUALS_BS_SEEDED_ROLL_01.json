      ],
      "@DataWarehouse.consumption.external": false,
      "@DataWarehouse.sqlEditor.query": "SELECT\n    X.\"Date_CALMONTH\",\n    X.\"D_XPA_COMPANY_CODE_ID\",\n    X.\"D_XPA_GL_ACCOUNT_ID\",\n    X.\"SOURCE_LEDGER\",\n    X.\"FISCAL_YEAR_VARIANT\",\n    X.\"FISCAL_YEAR\",\n    X.\"FISCAL_PERIOD\",\n    X.\"FISCAL_YEAR_PERIOD\",\n    X.\"FISCAL_PERIOD_START_DATE\",\n    X.\"FISCAL_PERIOD_END_DATE\",\n    X.\"ACCOUNT_CLASS\",\n    X.\"REPORTING_SIGN_FACTOR\",\n    X.\"AGGREGATION_CONFORMANCE_STATUS\",\n    X.\"SIGN_CONFORMANCE_STATUS\",\n    X.\"VALID_SEED_RECORD_ID\",\n    X.\"OPENING_DATE\",\n    X.\"MIGRATION_SOURCE_REFERENCE\",\n    X.\"MIGRATION_POSTING_DATE\",\n    X.\"MIGRATION_POSTING_MONTH\",\n    X.\"SEED_MOVEMENT_TREATMENT\",\n    X.\"OPENING_SEED_STATUS\",\n    X.\"MIGRATION_EXCLUSION_STATUS\",\n\n    CAST(\n        CASE\n            WHEN X.\"ROW_NUM\" = 1\n                THEN X.\"SEED_OPENING_BALANCE_RAW\"\n            ELSE X.\"SEED_OPENING_BALANCE_RAW\"\n               + COALESCE(\n                   X.\"PRIOR_EFFECTIVE_RAW_SUM\",\n                   CAST(0 AS DECIMAL(23, 2))\n                 )\n        END\n        AS DECIMAL(23, 2)\n    ) AS \"MEAS_FLOW_OPENING_RAW\",\n\n    CAST(\n        X.\"EFFECTIVE_MOVEMENT_RAW\"\n        AS DECIMAL(23, 2)\n    ) AS \"MEAS_FLOW_CHANGING_RAW\",\n\n    CASE\n        WHEN X.\"SEED_MOVEMENT_TREATMENT\" = 'EXCLUDE_MIGRATION_POSTING'\n         AND X.\"MIGRATION_EXCLUSION_STATUS\" <> 'RECONCILED'\n            THEN CAST(NULL AS DECIMAL(23, 2))\n        ELSE CAST(\n            X.\"SEED_OPENING_BALANCE_RAW\"\n            + COALESCE(\n                X.\"CURRENT_EFFECTIVE_RAW_SUM\",\n                CAST(0 AS DECIMAL(23, 2))\n              )\n            AS DECIMAL(23, 2)\n        )\n    END AS \"MEAS_FLOW_TOTAL_RAW\",\n\n    CAST(\n        CASE\n            WHEN X.\"ROW_NUM\" = 1\n                THEN X.\"SEED_OPENING_BALANCE_SIGNED\"\n            ELSE X.\"SEED_OPENING_BALANCE_SIGNED\"\n               + COALESCE(\n                   X.\"PRIOR_EFFECTIVE_SIGNED_SUM\",\n                   CAST(0 AS DECIMAL(23, 2))\n                 )\n        END\n        AS DECIMAL(23, 2)\n    ) AS \"MEAS_FLOW_OPENING\",\n\n    CAST(\n        X.\"EFFECTIVE_MOVEMENT_SIGNED\"\n        AS DECIMAL(23, 2)\n    ) AS \"MEAS_FLOW_CHANGING\",\n\n    CASE\n        WHEN X.\"SEED_MOVEMENT_TREATMENT\" = 'EXCLUDE_MIGRATION_POSTING'\n         AND X.\"MIGRATION_EXCLUSION_STATUS\" <> 'RECONCILED'\n            THEN CAST(NULL AS DECIMAL(23, 2))\n        ELSE CAST(\n            X.\"SEED_OPENING_BALANCE_SIGNED\"\n            + COALESCE(\n                X.\"CURRENT_EFFECTIVE_SIGNED_SUM\",\n                CAST(0 AS DECIMAL(23, 2))\n              )\n            AS DECIMAL(23, 2)\n        )\n    END AS \"MEAS_FLOW_TOTAL\"\n\nFROM (\n    SELECT\n        *,\n\n        ROW_NUMBER() OVER (\n            PARTITION BY\n                \"D_XPA_COMPANY_CODE_ID\",\n                \"D_XPA_GL_ACCOUNT_ID\",\n                \"SOURCE_LEDGER\"\n            ORDER BY\n                \"Date_CALMONTH\"\n        ) AS \"ROW_NUM\",\n\n        SUM(\"EFFECTIVE_MOVEMENT_RAW\") OVER (\n            PARTITION BY\n                \"D_XPA_COMPANY_CODE_ID\",\n                \"D_XPA_GL_ACCOUNT_ID\",\n                \"SOURCE_LEDGER\"\n            ORDER BY\n                \"Date_CALMONTH\"\n            ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING\n        ) AS \"PRIOR_EFFECTIVE_RAW_SUM\",\n\n        SUM(\"EFFECTIVE_MOVEMENT_RAW\") OVER (\n            PARTITION BY\n                \"D_XPA_COMPANY_CODE_ID\",\n                \"D_XPA_GL_ACCOUNT_ID\",\n                \"SOURCE_LEDGER\"\n            ORDER BY\n                \"Date_CALMONTH\"\n            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW\n        ) AS \"CURRENT_EFFECTIVE_RAW_SUM\",\n\n        SUM(\"EFFECTIVE_MOVEMENT_SIGNED\") OVER (\n            PARTITION BY\n                \"D_XPA_COMPANY_CODE_ID\",\n                \"D_XPA_GL_ACCOUNT_ID\",\n                \"SOURCE_LEDGER\"\n            ORDER BY\n                \"Date_CALMONTH\"\n            ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING\n        ) AS \"PRIOR_EFFECTIVE_SIGNED_SUM\",\n\n        SUM(\"EFFECTIVE_MOVEMENT_SIGNED\") OVER (\n            PARTITION BY\n                \"D_XPA_COMPANY_CODE_ID\",\n                \"D_XPA_GL_ACCOUNT_ID\",\n                \"SOURCE_LEDGER\"\n            ORDER BY\n                \"Date_CALMONTH\"\n            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW\n        ) AS \"CURRENT_EFFECTIVE_SIGNED_SUM\"\n\n    FROM \"3SV_FIN_CORE_ACTUALS_BS_SEEDED_SPINE_01\" \n) X;\n\n\n\n\n\n"
    }
  }
}
