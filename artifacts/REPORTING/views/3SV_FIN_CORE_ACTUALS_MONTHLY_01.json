      "@DataWarehouse.consumption.external": false,
      "@DataWarehouse.sqlEditor.query": "SELECT LEFT(ACTUAL.\"PostingDate\", 6) AS \"Date_CALMONTH\",\n\tACTUAL.\"CompanyCode\" AS \"D_XPA_COMPANY_CODE_ID\",\n\tACTUAL.\"GLAccount\" AS \"D_XPA_GL_ACCOUNT_ID\",\n\tACTUAL.\"CostCenter\" AS \"D_COST_CENTER_ID\",\n\tACTUAL.\"ProfitCenter\" AS \"D_PROFIT_CENTER_ID\",\n\tACTUAL.\"PartnerCompany\" AS \"D_TRADING_PARTNER_ID\",\n\tACTUAL.\"FunctionalArea\" AS \"D_FUNCTIONAL_AREA_ID\",\n\tFISCAL.\"FiscalYearVariant\" AS \"FISCAL_YEAR_VARIANT\",\n\tFISCAL.\"FiscalYear\" AS \"FISCAL_YEAR\",\n\tFISCAL.\"FiscalPeriod\" AS \"FISCAL_PERIOD\",\n\tFISCAL.\"FiscalYearPeriod\" AS \"FISCAL_YEAR_PERIOD\",\n\tTO_DATE(FISCAL.\"FiscalPeriodStartDate\", 'YYYYMMDD') AS \"FISCAL_PERIOD_START_DATE\",\n\tTO_DATE(FISCAL.\"FiscalPeriodEndDate\", 'YYYYMMDD') AS \"FISCAL_PERIOD_END_DATE\",\n\tACTUAL.\"DebitCreditCode\" As \"DEBIT_CREDIT_CODE\" ,\n\tSUM(ACTUAL.\"AmountInCompanyCodeCurrency\") AS \"MEAS_FLOW_CHANGING\"\nFROM \"3SV_FIN_JOURNAL_DETAIL_LIVE_01\" ACTUAL\n\tLEFT JOIN \"3GV_DIM_FISCALCALENDAR_01\" FISCAL ON FISCAL.\"FiscalYearVariant\" = 'V3' AND FISCAL.\"Language\" = 'EN' AND FISCAL.\"CalendarDate\" = ACTUAL.\"PostingDate\"\nWHERE ACTUAL.\"SourceLedger\" = '0L'\nGROUP BY LEFT(ACTUAL.\"PostingDate\", 6),\n\tACTUAL.\"CompanyCode\",\n\tACTUAL.\"GLAccount\",\n\tACTUAL.\"CostCenter\",\n\tACTUAL.\"ProfitCenter\",\n\tACTUAL.\"PartnerCompany\",\n\tACTUAL.\"FunctionalArea\",\n\tFISCAL.\"FiscalYearVariant\",\n\tFISCAL.\"FiscalYear\",\n\tFISCAL.\"FiscalPeriod\",\n\tFISCAL.\"FiscalYearPeriod\",\n\tTO_DATE(FISCAL.\"FiscalPeriodStartDate\", 'YYYYMMDD'),\n\tTO_DATE(FISCAL.\"FiscalPeriodEndDate\", 'YYYYMMDD') ,\n\tACTUAL.\"DebitCreditCode\""
