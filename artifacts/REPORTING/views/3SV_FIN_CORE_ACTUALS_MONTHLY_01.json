      "@DataWarehouse.sqlEditor.query": "SELECT LEFT(ACTUAL.\"PostingDate\", 6) AS \"Date_CALMONTH\", ACTUAL.\"CompanyCode\" AS \"D_XPA_COMPANY_CODE_ID\", ACTUAL.\"GLAccount\" AS \"D_XPA_GL_ACCOUNT_ID\", ACTUAL.\"CostCenter\" AS \"D_COST_CENTER_ID\", ACTUAL.\"ProfitCenter\" AS \"D_PROFIT_CENTER_ID\", ACTUAL.\"PartnerCompany\" AS \"D_TRADING_PARTNER_ID\", ACTUAL.\"FunctionalArea\" AS \"D_FUNCTIONAL_AREA_ID\", FISCAL.\"FiscalYearVariant\" AS \"FISCAL_YEAR_VARIANT\", FISCAL.\"FiscalYear\" AS \"FISCAL_YEAR\", FISCAL.\"FiscalPeriod\" AS \"FISCAL_PERIOD\", FISCAL.\"FiscalYearPeriod\" AS \"FISCAL_YEAR_PERIOD\", TO_DATE(FISCAL.\"FiscalPeriodStartDate\", 'YYYYMMDD') AS \"FISCAL_PERIOD_START_DATE\", TO_DATE(FISCAL.\"FiscalPeriodEndDate\", 'YYYYMMDD') AS \"FISCAL_PERIOD_END_DATE\", SUM(ACTUAL.\"AmountInCompanyCodeCurrency\") AS \"MEAS_FLOW_CHANGING\" FROM \"3SV_FIN_JOURNAL_DETAIL_LIVE_01\" ACTUAL LEFT JOIN \"3GV_DIM_FISCALCALENDAR_01\" FISCAL ON FISCAL.\"FiscalYearVariant\" = 'V3' AND FISCAL.\"Language\" = 'EN' AND FISCAL.\"CalendarDate\" = ACTUAL.\"PostingDate\" WHERE ACTUAL.\"SourceLedger\" = '0L' GROUP BY LEFT(ACTUAL.\"PostingDate\", 6), ACTUAL.\"CompanyCode\", ACTUAL.\"GLAccount\", ACTUAL.\"CostCenter\", ACTUAL.\"ProfitCenter\", ACTUAL.\"PartnerCompany\", ACTUAL.\"FunctionalArea\", FISCAL.\"FiscalYearVariant\", FISCAL.\"FiscalYear\", FISCAL.\"FiscalPeriod\", FISCAL.\"FiscalYearPeriod\", TO_DATE(FISCAL.\"FiscalPeriodStartDate\", 'YYYYMMDD'), TO_DATE(FISCAL.\"FiscalPeriodEndDate\", 'YYYYMMDD')",
