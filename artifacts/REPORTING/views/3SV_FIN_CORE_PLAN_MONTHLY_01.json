      "@DataWarehouse.consumption.external": false,
      "@DataWarehouse.sqlEditor.query": "SELECT PLAN.\"Date_CALMONTH\", PLAN.\"D_XPA_COMPANY_CODE_ID\", PLAN.\"D_XPA_GL_ACCOUNT_ID\", PLAN.\"D_COST_CENTER_ID\", PLAN.\"D_PROFIT_CENTER_ID\", PLAN.\"D_TRADING_PARTNER_ID\", PLAN.\"D_FUNCTIONAL_AREA_ID\", PLAN.\"Version_ID\", PLAN.\"D_SCENARIO_ID\", PLAN.\"D_AUDIT_TRAIL_ID\", FISCAL.\"FiscalYearVariant\" AS \"FISCAL_YEAR_VARIANT\", FISCAL.\"FiscalYear\" AS \"FISCAL_YEAR\", FISCAL.\"FiscalPeriod\" AS \"FISCAL_PERIOD\", FISCAL.\"FiscalYearPeriod\" AS \"FISCAL_YEAR_PERIOD\", TO_DATE(FISCAL.\"FiscalPeriodStartDate\", 'YYYYMMDD') AS \"FISCAL_PERIOD_START_DATE\", TO_DATE(FISCAL.\"FiscalPeriodEndDate\", 'YYYYMMDD') AS \"FISCAL_PERIOD_END_DATE\", PLAN.\"MEAS_FLOW_OPENING\", PLAN.\"MEAS_FLOW_CHANGING\", COALESCE(PLAN.\"MEAS_FLOW_OPENING\", 0) + COALESCE(PLAN.\"MEAS_FLOW_CHANGING\", 0) AS \"MEAS_FLOW_TOTAL\" FROM \"sap.sac.TB_MDL_FIN_CORE\" PLAN LEFT JOIN \"3GV_DIM_FISCALCALENDAR_01\" FISCAL ON FISCAL.\"FiscalYearVariant\" = 'V3' AND FISCAL.\"Language\" = 'EN' AND FISCAL.\"CalendarDate\" = CONCAT(PLAN.\"Date_CALMONTH\", '01')"
