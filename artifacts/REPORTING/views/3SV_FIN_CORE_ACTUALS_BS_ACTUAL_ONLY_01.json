      "@DataWarehouse.consumption.external": false,
      "@DataWarehouse.sqlEditor.query": "SELECT\r\n    A.\"Date_CALMONTH\",\r\n    A.\"D_XPA_COMPANY_CODE_ID\",\r\n    A.\"D_XPA_GL_ACCOUNT_ID\",\r\n    A.\"SOURCE_LEDGER\",\r\n    A.\"FISCAL_YEAR_VARIANT\",\r\n    A.\"FISCAL_YEAR\",\r\n    A.\"FISCAL_PERIOD\",\r\n    A.\"FISCAL_YEAR_PERIOD\",\r\n    A.\"FISCAL_PERIOD_START_DATE\",\r\n    A.\"FISCAL_PERIOD_END_DATE\",\r\n    A.\"ACCOUNT_CLASS\",\r\n    A.\"REPORTING_SIGN_FACTOR\",\r\n    A.\"AGGREGATION_CONFORMANCE_STATUS\",\r\n    A.\"SIGN_CONFORMANCE_STATUS\",\r\n\r\n    CAST(NULL AS NVARCHAR(100)) AS \"VALID_SEED_RECORD_ID\",\r\n    CAST(NULL AS DATE) AS \"OPENING_DATE\",\r\n    CAST(NULL AS NVARCHAR(200)) AS \"MIGRATION_SOURCE_REFERENCE\",\r\n    CAST(NULL AS DATE) AS \"MIGRATION_POSTING_DATE\",\r\n    CAST(NULL AS NVARCHAR(6)) AS \"MIGRATION_POSTING_MONTH\",\r\n    CAST(NULL AS NVARCHAR(40)) AS \"SEED_MOVEMENT_TREATMENT\",\r\n\r\n    COALESCE(\r\n        SE.\"OPENING_SEED_STATUS\",\r\n        'SEED_PENDING_MIGRATED_S4'\r\n    ) AS \"OPENING_SEED_STATUS\",\r\n\r\n    'NOT_REQUIRED' AS \"MIGRATION_EXCLUSION_STATUS\",\r\n\r\n    CAST(NULL AS DECIMAL(23, 2)) AS \"MEAS_FLOW_OPENING_RAW\",\r\n    CAST(A.\"MEAS_FLOW_CHANGING_RAW\" AS DECIMAL(23, 2))\r\n        AS \"MEAS_FLOW_CHANGING_RAW\",\r\n    CAST(NULL AS DECIMAL(23, 2)) AS \"MEAS_FLOW_TOTAL_RAW\",\r\n\r\n    CAST(NULL AS DECIMAL(23, 2)) AS \"MEAS_FLOW_OPENING\",\r\n    CAST(A.\"MEAS_FLOW_CHANGING\" AS DECIMAL(23, 2))\r\n        AS \"MEAS_FLOW_CHANGING\",\r\n    CAST(NULL AS DECIMAL(23, 2)) AS \"MEAS_FLOW_TOTAL\"\r\n\r\nFROM \"3SV_FIN_CORE_ACTUALS_BS_MONTHLY_01\" A\r\n\r\nLEFT JOIN \"3SV_FIN_CORE_ACTUALS_BS_SEED_ENRICHED_01\" SE\r\n    ON SE.\"D_XPA_COMPANY_CODE_ID\" = A.\"D_XPA_COMPANY_CODE_ID\"\r\n   AND SE.\"D_XPA_GL_ACCOUNT_ID\" = A.\"D_XPA_GL_ACCOUNT_ID\"\r\n   AND SE.\"SOURCE_LEDGER\" = A.\"SOURCE_LEDGER\"\r\n\r\nWHERE COALESCE(\r\n          SE.\"OPENING_SEED_STATUS\",\r\n          'SEED_PENDING_MIGRATED_S4'\r\n      ) <> 'SEED_AVAILABLE'"
