      },
      "@DataWarehouse.consumption.external": false,
      "@DataWarehouse.sqlEditor.query": "SELECT\r\n    M.\"Date_CALMONTH\",\r\n    M.\"FISCAL_YEAR_VARIANT\",\r\n    M.\"FISCAL_YEAR\",\r\n    M.\"FISCAL_PERIOD\",\r\n    M.\"FISCAL_YEAR_PERIOD\",\r\n    M.\"FISCAL_PERIOD_START_DATE\",\r\n    M.\"FISCAL_PERIOD_END_DATE\"\r\nFROM (\r\n    SELECT\r\n        SUBSTRING(CAL.\"CalendarDate\", 1, 6) AS \"Date_CALMONTH\",\r\n        CAL.\"FiscalYearVariant\" AS \"FISCAL_YEAR_VARIANT\",\r\n        CAL.\"FiscalYear\" AS \"FISCAL_YEAR\",\r\n        CAL.\"FiscalPeriod\" AS \"FISCAL_PERIOD\",\r\n        CAL.\"FiscalYearPeriod\" AS \"FISCAL_YEAR_PERIOD\",\r\n        TO_DATE(MIN(CAL.\"FiscalPeriodStartDate\"), 'YYYYMMDD') AS \"FISCAL_PERIOD_START_DATE\",\r\n        TO_DATE(MAX(CAL.\"FiscalPeriodEndDate\"), 'YYYYMMDD') AS \"FISCAL_PERIOD_END_DATE\"\r\n    FROM \"3GV_DIM_FISCALCALENDAR_01\" CAL\r\n    WHERE CAL.\"FiscalYearVariant\" = 'V3'\r\n      AND CAL.\"Language\" = 'EN'\r\n    GROUP BY\r\n        SUBSTRING(CAL.\"CalendarDate\", 1, 6),\r\n        CAL.\"FiscalYearVariant\",\r\n        CAL.\"FiscalYear\",\r\n        CAL.\"FiscalPeriod\",\r\n        CAL.\"FiscalYearPeriod\"\r\n) M\r\nCROSS JOIN (\r\n    SELECT MAX(\"Date_CALMONTH\") AS \"MAX_CALMONTH\"\r\n    FROM \"3SV_FIN_CORE_ACTUALS_SIGNED_MONTHLY_01\"\r\n) L\r\nWHERE M.\"Date_CALMONTH\" <= L.\"MAX_CALMONTH\""
