      "@DataWarehouse.consumption.external": false,
      "@DataWarehouse.sqlEditor.query": "SELECT\r\n    MS.\"Date_CALMONTH\",\r\n    SE.\"D_XPA_COMPANY_CODE_ID\",\r\n    SE.\"D_XPA_GL_ACCOUNT_ID\",\r\n    SE.\"SOURCE_LEDGER\",\r\n    MS.\"FISCAL_YEAR_VARIANT\",\r\n    MS.\"FISCAL_YEAR\",\r\n    MS.\"FISCAL_PERIOD\",\r\n    MS.\"FISCAL_YEAR_PERIOD\",\r\n    MS.\"FISCAL_PERIOD_START_DATE\",\r\n    MS.\"FISCAL_PERIOD_END_DATE\",\r\n\r\n    CASE\r\n        WHEN A.\"Date_CALMONTH\" IS NOT NULL THEN A.\"ACCOUNT_CLASS\"\r\n        ELSE SE.\"SEED_ACCOUNT_CLASS\"\r\n    END AS \"ACCOUNT_CLASS\",\r\n\r\n    CASE\r\n        WHEN A.\"Date_CALMONTH\" IS NOT NULL THEN A.\"REPORTING_SIGN_FACTOR\"\r\n        ELSE SE.\"SEED_REPORTING_SIGN_FACTOR\"\r\n    END AS \"REPORTING_SIGN_FACTOR\",\r\n\r\n    CASE\r\n        WHEN A.\"Date_CALMONTH\" IS NOT NULL THEN A.\"AGGREGATION_CONFORMANCE_STATUS\"\r\n        ELSE 'NOT_APPLICABLE'\r\n    END AS \"AGGREGATION_CONFORMANCE_STATUS\",\r\n\r\n    CASE\r\n        WHEN A.\"Date_CALMONTH\" IS NOT NULL THEN A.\"SIGN_CONFORMANCE_STATUS\"\r\n        ELSE 'NOT_APPLICABLE'\r\n    END AS \"SIGN_CONFORMANCE_STATUS\",\r\n\r\n    SE.\"VALID_SEED_RECORD_ID\",\r\n    SE.\"OPENING_DATE\",\r\n    SE.\"OPENING_BALANCE_RAW\",\r\n    SE.\"SEED_MOVEMENT_TREATMENT\",\r\n    SE.\"MIGRATION_SOURCE_REFERENCE\",\r\n    SE.\"MIGRATION_POSTING_DATE\",\r\n    SE.\"MIGRATION_POSTING_MONTH\",\r\n    SE.\"MIGRATION_MOVEMENT_EXCLUSION_RAW\",\r\n    SE.\"MIGRATION_MOVEMENT_EXCLUSION_SIGNED\",\r\n    SE.\"MIGRATION_RECONCILIATION_STATUS\",\r\n    SE.\"MIGRATION_RECONCILIATION_REFERENCE\",\r\n    SE.\"MIGRATION_RECONCILED_TIMESTAMP\",\r\n    SE.\"MIGRATION_EXCLUSION_STATUS\",\r\n    SE.\"SEED_ACCOUNT_CLASS\",\r\n    SE.\"SEED_REPORTING_SIGN_FACTOR\",\r\n    SE.\"OPENING_SEED_STATUS\",\r\n\r\n    CASE\r\n        WHEN A.\"Date_CALMONTH\" IS NOT NULL THEN 1\r\n        ELSE 0\r\n    END AS \"HAS_ACTUAL_ROW\",\r\n\r\n    TO_DECIMAL(COALESCE(A.\"MEAS_FLOW_CHANGING_RAW\", 0)) AS \"ACTUAL_MOVEMENT_RAW\",\r\n    TO_DECIMAL(COALESCE(A.\"MEAS_FLOW_CHANGING\", 0)) AS \"ACTUAL_MOVEMENT_SIGNED\",\r\n\r\n    CASE\r\n        WHEN A.\"Date_CALMONTH\" IS NOT NULL\r\n         AND SE.\"MIGRATION_EXCLUSION_STATUS\" = 'RECONCILED'\r\n         AND A.\"Date_CALMONTH\" = SE.\"MIGRATION_POSTING_MONTH\"\r\n            THEN TO_DECIMAL(COALESCE(A.\"MEAS_FLOW_CHANGING_RAW\", 0))\r\n               - TO_DECIMAL(COALESCE(SE.\"MIGRATION_MOVEMENT_EXCLUSION_RAW\", 0))\r\n        ELSE TO_DECIMAL(COALESCE(A.\"MEAS_FLOW_CHANGING_RAW\", 0))\r\n    END AS \"EFFECTIVE_MOVEMENT_RAW\",\r\n\r\n    CASE\r\n        WHEN A.\"Date_CALMONTH\" IS NOT NULL\r\n         AND SE.\"MIGRATION_EXCLUSION_STATUS\" = 'RECONCILED'\r\n         AND A.\"Date_CALMONTH\" = SE.\"MIGRATION_POSTING_MONTH\"\r\n            THEN TO_DECIMAL(COALESCE(A.\"MEAS_FLOW_CHANGING\", 0))\r\n               - TO_DECIMAL(COALESCE(SE.\"MIGRATION_MOVEMENT_EXCLUSION_SIGNED\", 0))\r\n        ELSE TO_DECIMAL(COALESCE(A.\"MEAS_FLOW_CHANGING\", 0))\r\n    END AS \"EFFECTIVE_MOVEMENT_SIGNED\",\r\n\r\n    TO_DECIMAL(COALESCE(SE.\"OPENING_BALANCE_RAW\", 0)) AS \"SEED_OPENING_BALANCE_RAW\",\r\n\r\n    TO_DECIMAL(COALESCE(SE.\"OPENING_BALANCE_RAW\", 0))\r\n        * TO_DECIMAL(\r\n            CASE\r\n                WHEN SE.\"SEED_REPORTING_SIGN_FACTOR\" IN (1, -1)\r\n                    THEN SE.\"SEED_REPORTING_SIGN_FACTOR\"\r\n                ELSE 1\r\n            END\r\n        ) AS \"SEED_OPENING_BALANCE_SIGNED\"\r\n\r\nFROM \"3SV_FIN_CORE_ACTUALS_BS_SEED_ENRICHED_01\" SE\r\n\r\nINNER JOIN \"3SV_FIN_CORE_ACTUALS_BS_MONTH_SCOPE_01\" MS\r\n    ON MS.\"FISCAL_PERIOD_START_DATE\" >= SE.\"OPENING_DATE\"\r\n\r\nLEFT JOIN \"3SV_FIN_CORE_ACTUALS_BS_MONTHLY_01\" A\r\n    ON A.\"Date_CALMONTH\" = MS.\"Date_CALMONTH\"\r\n   AND A.\"D_XPA_COMPANY_CODE_ID\" = SE.\"D_XPA_COMPANY_CODE_ID\"\r\n   AND A.\"D_XPA_GL_ACCOUNT_ID\" = SE.\"D_XPA_GL_ACCOUNT_ID\"\r\n   AND A.\"SOURCE_LEDGER\" = SE.\"SOURCE_LEDGER\"\r\n\r\nWHERE SE.\"OPENING_SEED_STATUS\" = 'SEED_AVAILABLE'"
    }
  }
}
