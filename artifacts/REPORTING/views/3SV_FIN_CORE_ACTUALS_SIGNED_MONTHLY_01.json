      "@DataWarehouse.sqlEditor.query": "SELECT RAW.\"Date_CALMONTH\" AS \"Date_CALMONTH\", RAW.\"D_XPA_COMPANY_CODE_ID\" AS \"D_XPA_COMPANY_CODE_ID\", RAW.\"D_XPA_GL_ACCOUNT_ID\" AS \"D_XPA_GL_ACCOUNT_ID\", RAW.\"D_COST_CENTER_ID\" AS \"D_COST_CENTER_ID\", RAW.\"D_PROFIT_CENTER_ID\" AS \"D_PROFIT_CENTER_ID\", RAW.\"D_TRADING_PARTNER_ID\" AS \"D_TRADING_PARTNER_ID\", RAW.\"D_FUNCTIONAL_AREA_ID\" AS \"D_FUNCTIONAL_AREA_ID\", RAW.\"FISCAL_YEAR_VARIANT\" AS \"FISCAL_YEAR_VARIANT\", RAW.\"FISCAL_YEAR\" AS \"FISCAL_YEAR\", RAW.\"FISCAL_PERIOD\" AS \"FISCAL_PERIOD\", RAW.\"FISCAL_YEAR_PERIOD\" AS \"FISCAL_YEAR_PERIOD\", RAW.\"FISCAL_PERIOD_START_DATE\" AS \"FISCAL_PERIOD_START_DATE\", RAW.\"FISCAL_PERIOD_END_DATE\" AS \"FISCAL_PERIOD_END_DATE\", GLCLASS.\"ACCOUNT_CLASS\" AS \"ACCOUNT_CLASS\", SIGNRULE.\"REPORTING_SIGN_FACTOR\" AS \"REPORTING_SIGN_FACTOR\", CASE WHEN GLCLASS.\"ACCOUNT_CLASS\" IS NULL THEN 'UNCLASSIFIED_GL' WHEN SIGNRULE.\"REPORTING_SIGN_FACTOR\" IS NULL THEN 'MISSING_SIGN_RULE' WHEN SIGNRULE.\"REPORTING_SIGN_FACTOR\" NOT IN (-1, 1) THEN 'INVALID_SIGN_RULE' ELSE 'SIGNED' END AS \"SIGN_CONFORMANCE_STATUS\", SUM(RAW.\"MEAS_FLOW_CHANGING\") AS \"MEAS_FLOW_CHANGING_RAW\", SUM(RAW.\"MEAS_FLOW_CHANGING\" * CASE WHEN SIGNRULE.\"REPORTING_SIGN_FACTOR\" IN (-1, 1) THEN SIGNRULE.\"REPORTING_SIGN_FACTOR\" ELSE 1 END) AS \"MEAS_FLOW_CHANGING\" FROM \"3SV_FIN_CORE_ACTUALS_MONTHLY_01\" RAW LEFT JOIN \"MODELLING.2LT_CTRL_FIN_GL_ACCOUNT_CLASS_01\" GLCLASS ON RAW.\"D_XPA_GL_ACCOUNT_ID\" = GLCLASS.\"GL_ACCOUNT_ID\" AND GLCLASS.\"IS_ACTIVE\" = true AND (GLCLASS.\"VALID_FROM\" IS NULL OR GLCLASS.\"VALID_FROM\" <= RAW.\"FISCAL_PERIOD_END_DATE\") AND (GLCLASS.\"VALID_TO\" IS NULL OR GLCLASS.\"VALID_TO\" >= RAW.\"FISCAL_PERIOD_END_DATE\") LEFT JOIN \"MODELLING.2LT_CTRL_FIN_ACCOUNT_CLASS_SIGN_RULE_01\" SIGNRULE ON GLCLASS.\"ACCOUNT_CLASS\" = SIGNRULE.\"ACCOUNT_CLASS\" AND SIGNRULE.\"IS_ACTIVE\" = true AND (SIGNRULE.\"VALID_FROM\" IS NULL OR SIGNRULE.\"VALID_FROM\" <= RAW.\"FISCAL_PERIOD_END_DATE\") AND (SIGNRULE.\"VALID_TO\" IS NULL OR SIGNRULE.\"VALID_TO\" >= RAW.\"FISCAL_PERIOD_END_DATE\") GROUP BY RAW.\"Date_CALMONTH\", RAW.\"D_XPA_COMPANY_CODE_ID\", RAW.\"D_XPA_GL_ACCOUNT_ID\", RAW.\"D_COST_CENTER_ID\", RAW.\"D_PROFIT_CENTER_ID\", RAW.\"D_TRADING_PARTNER_ID\", RAW.\"D_FUNCTIONAL_AREA_ID\", RAW.\"FISCAL_YEAR_VARIANT\", RAW.\"FISCAL_YEAR\", RAW.\"FISCAL_PERIOD\", RAW.\"FISCAL_YEAR_PERIOD\", RAW.\"FISCAL_PERIOD_START_DATE\", RAW.\"FISCAL_PERIOD_END_DATE\", GLCLASS.\"ACCOUNT_CLASS\", SIGNRULE.\"REPORTING_SIGN_FACTOR\", CASE WHEN GLCLASS.\"ACCOUNT_CLASS\" IS NULL THEN 'UNCLASSIFIED_GL' WHEN SIGNRULE.\"REPORTING_SIGN_FACTOR\" IS NULL THEN 'MISSING_SIGN_RULE' WHEN SIGNRULE.\"REPORTING_SIGN_FACTOR\" NOT IN (-1, 1) THEN 'INVALID_SIGN_RULE' ELSE 'SIGNED' END",
