      "@DataWarehouse.consumption.external": false,
      "@DataWarehouse.sqlEditor.query": "\nSELECT\n    RAW.\"Date_CALMONTH\" AS \"Date_CALMONTH\",\n    RAW.\"D_XPA_COMPANY_CODE_ID\" AS \"D_XPA_COMPANY_CODE_ID\",\n    RAW.\"D_XPA_GL_ACCOUNT_ID\" AS \"D_XPA_GL_ACCOUNT_ID\",\n    RAW.\"D_COST_CENTER_ID\" AS \"D_COST_CENTER_ID\",\n    RAW.\"D_PROFIT_CENTER_ID\" AS \"D_PROFIT_CENTER_ID\",\n    RAW.\"D_TRADING_PARTNER_ID\" AS \"D_TRADING_PARTNER_ID\",\n    RAW.\"D_FUNCTIONAL_AREA_ID\" AS \"D_FUNCTIONAL_AREA_ID\",\n    RAW.\"FISCAL_YEAR_VARIANT\" AS \"FISCAL_YEAR_VARIANT\",\n    RAW.\"FISCAL_YEAR\" AS \"FISCAL_YEAR\",\n    RAW.\"FISCAL_PERIOD\" AS \"FISCAL_PERIOD\",\n    RAW.\"FISCAL_YEAR_PERIOD\" AS \"FISCAL_YEAR_PERIOD\",\n    RAW.\"FISCAL_PERIOD_START_DATE\" AS \"FISCAL_PERIOD_START_DATE\",\n    RAW.\"FISCAL_PERIOD_END_DATE\" AS \"FISCAL_PERIOD_END_DATE\",\n\n    UPPER(TRIM(RAW.\"DEBIT_CREDIT_CODE\")) AS \"DEBIT_CREDIT_CODE\",\n\n    CASE\n        WHEN UPPER(TRIM(RAW.\"DEBIT_CREDIT_CODE\")) = 'S' THEN 'DEBIT'\n        WHEN UPPER(TRIM(RAW.\"DEBIT_CREDIT_CODE\")) = 'H' THEN 'CREDIT'\n        ELSE 'INVALID_OR_MISSING_DC'\n    END AS \"DEBIT_CREDIT_STATUS\",\n\n    GLCLASS.\"ACCOUNT_CLASS\" AS \"ACCOUNT_CLASS\",\n    SIGNRULE.\"REPORTING_SIGN_FACTOR\" AS \"REPORTING_SIGN_FACTOR\",\n\n    CASE\n        WHEN GLCLASS.\"ACCOUNT_CLASS\" IS NULL THEN 'UNCLASSIFIED_GL'\n        WHEN SIGNRULE.\"REPORTING_SIGN_FACTOR\" IS NULL THEN 'MISSING_SIGN_RULE'\n        WHEN SIGNRULE.\"REPORTING_SIGN_FACTOR\" NOT IN (-1, 1) THEN 'INVALID_SIGN_RULE'\n        ELSE 'SIGNED'\n    END AS \"SIGN_CONFORMANCE_STATUS\",\n\n    SUM(RAW.\"MEAS_FLOW_CHANGING\") AS \"MEAS_FLOW_CHANGING_RAW\",\n\n    SUM(\n        CASE\n            WHEN UPPER(TRIM(RAW.\"DEBIT_CREDIT_CODE\")) IN ('S', 'H')\n             AND SIGNRULE.\"REPORTING_SIGN_FACTOR\" IN (-1, 1)\n            THEN\n                CASE\n                    WHEN UPPER(TRIM(RAW.\"DEBIT_CREDIT_CODE\")) = 'S'\n                        THEN ABS(RAW.\"MEAS_FLOW_CHANGING\")\n                    WHEN UPPER(TRIM(RAW.\"DEBIT_CREDIT_CODE\")) = 'H'\n                        THEN -ABS(RAW.\"MEAS_FLOW_CHANGING\")\n                END\n                * SIGNRULE.\"REPORTING_SIGN_FACTOR\"\n\n            ELSE RAW.\"MEAS_FLOW_CHANGING\"\n        END\n    ) AS \"MEAS_FLOW_CHANGING\"\n\nFROM \"3SV_FIN_CORE_ACTUALS_MONTHLY_01\" RAW\n\nLEFT JOIN \"MODELLING.2LT_CTRL_FIN_GL_ACCOUNT_CLASS_01\" GLCLASS\n    ON RAW.\"D_XPA_GL_ACCOUNT_ID\" = GLCLASS.\"GL_ACCOUNT_ID\"\n    AND GLCLASS.\"IS_ACTIVE\" = TRUE\n    AND (\n        GLCLASS.\"VALID_FROM\" IS NULL\n        OR GLCLASS.\"VALID_FROM\" <= RAW.\"FISCAL_PERIOD_END_DATE\"\n    )\n    AND (\n        GLCLASS.\"VALID_TO\" IS NULL\n        OR GLCLASS.\"VALID_TO\" >= RAW.\"FISCAL_PERIOD_END_DATE\"\n    )\n\nLEFT JOIN \"MODELLING.2LT_CTRL_FIN_ACCOUNT_CLASS_SIGN_RULE_01\" SIGNRULE\n    ON GLCLASS.\"ACCOUNT_CLASS\" = SIGNRULE.\"ACCOUNT_CLASS\"\n    AND SIGNRULE.\"IS_ACTIVE\" = TRUE\n    AND (\n        SIGNRULE.\"VALID_FROM\" IS NULL\n        OR SIGNRULE.\"VALID_FROM\" <= RAW.\"FISCAL_PERIOD_END_DATE\"\n    )\n    AND (\n        SIGNRULE.\"VALID_TO\" IS NULL\n        OR SIGNRULE.\"VALID_TO\" >= RAW.\"FISCAL_PERIOD_END_DATE\"\n    )\n\nGROUP BY\n    RAW.\"Date_CALMONTH\",\n    RAW.\"D_XPA_COMPANY_CODE_ID\",\n    RAW.\"D_XPA_GL_ACCOUNT_ID\",\n    RAW.\"D_COST_CENTER_ID\",\n    RAW.\"D_PROFIT_CENTER_ID\",\n    RAW.\"D_TRADING_PARTNER_ID\",\n    RAW.\"D_FUNCTIONAL_AREA_ID\",\n    RAW.\"FISCAL_YEAR_VARIANT\",\n    RAW.\"FISCAL_YEAR\",\n    RAW.\"FISCAL_PERIOD\",\n    RAW.\"FISCAL_YEAR_PERIOD\",\n    RAW.\"FISCAL_PERIOD_START_DATE\",\n    RAW.\"FISCAL_PERIOD_END_DATE\",\n    UPPER(TRIM(RAW.\"DEBIT_CREDIT_CODE\")),\n    GLCLASS.\"ACCOUNT_CLASS\",\n    SIGNRULE.\"REPORTING_SIGN_FACTOR\""
    },
